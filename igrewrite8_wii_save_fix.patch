diff --git a/igLibrary/Core/igIGZSaver.cs b/igLibrary/Core/igIGZSaver.cs
index 4301f2e..9e82f45 100644
--- a/igLibrary/Core/igIGZSaver.cs
+++ b/igLibrary/Core/igIGZSaver.cs
@@ -80,7 +80,22 @@ namespace igLibrary.Core
 		public void WriteFile(igObjectDirectory dir, Stream dst, IG_CORE_PLATFORM platform)
 		{
 			_platform = platform;
-			_version = 0x09;
+			// Real bug fix: this used to be hardcoded to 0x09 unconditionally,
+			// for every save regardless of what version the file was actually
+			// loaded as. Confirmed against real game files this breaks: real
+			// Skylanders: Spyro's Adventure Wii .igz files are version 5, not
+			// 9 (Wii U's own SSA build separately confirmed version 7) -- the
+			// rest of this saver's logic is already version-aware (see the
+			// `_version <= 0x06`, `_version < 0x09`, `_version > 7` branches
+			// throughout this file), it was just never being given the real
+			// version to branch on. `dir._loader` is the real igIGZLoader
+			// that loaded this directory (see igObjectDirectory._loader) and
+			// already has the real version it read directly from the file's
+			// own header -- use that when re-saving a loaded file, falling
+			// back to the current latest version (9) only for a directory
+			// that was never loaded from a file at all (i.e. genuinely new
+			// content authored from scratch in the editor).
+			_version = dir._loader?._version ?? 0x09;
 			_stream = new StreamHelper(dst, igAlchemyCore.isPlatformBigEndian(platform) ? StreamHelper.Endianness.Big : StreamHelper.Endianness.Little);
 			_dir = dir;
 
