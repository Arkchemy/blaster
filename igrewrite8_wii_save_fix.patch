diff --git a/igLibrary/Core/igIGZObjectLoader.cs b/igLibrary/Core/igIGZObjectLoader.cs
index 80d32a2..6b7d30a 100644
--- a/igLibrary/Core/igIGZObjectLoader.cs
+++ b/igLibrary/Core/igIGZObjectLoader.cs
@@ -22,6 +22,12 @@ namespace igLibrary.Core
 			dir._type = igObjectDirectory.FileType.kIGZ;
 			loader.Read(dir, true);
 			dir._fd = loader._fd;
+			// Real bug found alongside the igIGZSaver hardcoded-version fix:
+			// igObjectDirectory._loader was declared but never actually
+			// assigned anywhere in this codebase, so igIGZSaver reading
+			// `dir._loader?._version` would always silently fall through to
+			// its own default -- this is the other real half of that fix.
+			dir._loader = loader;
 		}
